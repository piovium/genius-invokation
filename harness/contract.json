        "check:sim-nav"
      ],
      "timeoutMs": 1800000
    },
    {
      "id": "tnb-volar",
      "covers": [
        "R1"
      ],
      "kind": "volar",
      "repository": "tnb",
      "condition": "tnb-changed",
      "requires": [
        "tnb-guards"
