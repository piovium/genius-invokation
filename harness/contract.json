      "property-type-error",
      "invalid-import",
      "unsaved-edit",
      "external-disk-edit",
      "close-reopen",
      "dependency-change",
      "unicode-crlf-space-path",
      "electron-extension-host"
    ],
    "coverageScenarios": [
      "current-card",
      "historical-card",
      "import-only-file",
      "cross-package-consumer"
    ]
  },
