      ],
      "timeoutMs": 1800000
    },
    {
      "id": "tnb-guards",
      "covers": [
        "R1"
      ],
      "kind": "tnb-guards",
      "repository": "tnb",
      "condition": "tnb-changed",
      "timeoutMs": 600000
    },
    {
      "id": "tnb-witnesses",
      "covers": [
        "R1"
      ],
      "kind": "tnb-witnesses",
      "repository": "tnb",
      "condition": "tnb-changed",
      "requires": [
