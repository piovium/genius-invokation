{
  "schemaVersion": 1,
  "version": "2.4.0",
  "phase": "migration",
  "tnbVersion": "6.0.3-bridge.16.tsgo.7.0.2",
  "policy": {
    "desktopEditRounds": 100,
    "dataRuns": 3,
    "requiredPlatforms": [
      "win32",
      "linux"
    ],
    "forbidEnvironment": [
      "NO_TYPING",
      "PUBLISH"
    ],
    "reportLimitBytes": 67108864,
    "requireTnbRegression": true,
    "desktopScenarios": [
      "root-workspace",
      "examples-workspace",
      "syntax-error",
      "property-type-error",
      "invalid-import",
      "unsaved-edit",
      "external-disk-edit",
      "close-reopen",
      "dependency-change",
      "unicode-crlf-space-path",
      "packed-vsix-install",
      "electron-extension-host"
    ],
    "coverageScenarios": [
      "current-card",
      "historical-card",
      "import-only-file",
      "cross-package-consumer"
    ]
  },
  "repositories": {
    "main": {
      "path": "worktrees/genius-invokation",
      "base": "e0be9cd6d3758026a301ef91c65e6bf419bd595e",
      "name": "genius-invokation",
      "manager": "pnpmMain",
      "managerVersion": "12.0.0"
    },
    "gts": {
      "path": "worktrees/gts",
      "base": "cf58a100132ef02af61c6a22a49feb1968841f06",
      "name": "@gi-tcg/gts",
      "manager": "pnpmGts",
      "managerVersion": "11.5.2"
    },
    "tnb": {
      "path": "worktrees/typescript-native-bridge",
      "base": "9281a12c7c4e42dc50c0c27a8dba4a0e93639ddc",
      "name": "typescript-native-bridge",
      "manager": "npm"
    }
  },
  "roles": {
    "integration": {
      "repository": "main",
      "paths": [
        "package.json",
        "pnpm-workspace.yaml",
        "pnpm-lock.yaml",
        ".vscode/",
        ".github/",
        "docs/",
        ".gitattributes",
        "patches/",
        "packages/custom-data-loader/",
        "vitest.setup.ts",
        "packages/detail-log-viewer/src/DetailLogViewer.tsx",
        "packages/core/package.json"
      ],
      "gates": [
        "environment",
        "inventory",
        "engine",
        "data",
        "coverage",
        "checks",
        "main-build",
        "main-tests",
        "memory",
        "clean-install"
      ]
    },
    "gts": {
      "repository": "gts",
      "paths": [
        "packages/",
        "examples/",
        "package.json",
        "pnpm-workspace.yaml",
        "pnpm-lock.yaml",
        "patches/",
        "docs/content/docs/internal/index.md",
        "docs/content/docs/internal/build-plugins.md",
