        "docs/content/docs/runtime-guide/transpilation-output.mdx",
        "docs/content/docs/user-guide/entity.mdx",
        "docs/content/docs/user-guide/skill.mdx",
        "docs/content/docs/user-guide/typescript-interop.mdx"
      ],
      "gates": [
        "engine",
        "gts-engine",
        "gts-build",
        "gts-tests",
        "desktop",
        "gts-lsp"
      ],
      "inheritedGates": [
        "engine"
      ]
    },
    "tnb": {
      "repository": "tnb",
      "paths": [
        "patches/",
        "tools/",
        "typescript/",
        "typescript-go/",
        "README.md",
        "package.json",
        "package-lock.json"
      ],
      "gates": [
        "tnb-guards",
        "tnb-witnesses",
        "tnb-navigation",
        "tnb-volar"
      ]
    }
  },
  "gates": [
    {
      "id": "environment",
      "covers": [
        "E0"
      ],
      "kind": "environment",
      "repository": "main",
      "timeoutMs": 30000
    },
    {
      "id": "inventory",
      "covers": [
        "C2"
      ],
      "kind": "inventory",
      "repository": "main",
      "timeoutMs": 30000
    },
    {
      "id": "engine",
      "covers": [
        "E1"
      ],
      "kind": "engine",
      "repository": "main",
      "requires": [
        "environment"
      ],
      "timeoutMs": 180000
    },
    {
      "id": "data",
      "covers": [
        "C1"
      ],
      "kind": "data",
      "repository": "main",
      "requires": [
        "engine",
        "inventory"
      ],
      "timeoutMs": 600000
    },
    {
      "id": "coverage",
      "covers": [
        "C2"
      ],
      "kind": "coverage",
      "repository": "main",
      "requires": [
        "engine",
        "inventory"
      ],
      "timeoutMs": 600000,
      "blocked": "No reviewed coverage collector is registered. Registering it requires real per-path program observations for every main-repository GTS file plus the current, historical, unimported and cross-package negative and repair scenarios."
    },
    {
      "id": "checks",
      "covers": [
        "C3"
      ],
      "kind": "checks",
      "repository": "main",
      "requires": [
        "engine",
        "inventory"
      ],
      "timeoutMs": 600000
    },
    {
      "id": "gts-engine",
      "covers": [
        "E1"
      ],
      "kind": "engine",
      "repository": "gts",
      "requires": [
        "environment"
      ],
      "timeoutMs": 180000
    },
    {
      "id": "gts-build",
      "covers": [
        "R1"
      ],
      "kind": "command",
      "repository": "gts",
      "requires": [
        "environment"
      ],
      "args": [
        "build"
      ],
      "timeoutMs": 600000
    },
    {
      "id": "gts-tests",
      "covers": [
        "R1"
      ],
      "kind": "command",
      "repository": "gts",
      "requires": [
        "gts-build"
      ],
      "args": [
        "test"
      ],
      "timeoutMs": 600000
    },
    {
      "id": "gts-lsp",
      "covers": [
        "L1",
        "E1"
      ],
      "kind": "collector",
      "repository": "gts",
      "requires": [
        "gts-engine",
        "gts-build"
      ],
      "timeoutMs": 900000
    },
    {
      "id": "desktop",
      "covers": [
        "L1",
        "L2",
        "L3",
        "L4",
        "E1"
      ],
      "kind": "session",
      "case": "desktop",
      "repository": "gts",
      "requires": [
        "gts-engine",
        "gts-build"
      ],
      "timeoutMs": 1800000,
      "blocked": "The desktop draft is bound to the retired main-repository workspace pair. Registering it requires rebinding the target to the GTS checkout, implementing the packed-VSIX install launch mode, completing the shared Linux process cleanup, and collecting real 100-round evidence."
    },
    {
      "id": "main-build",
      "covers": [
        "R1"
      ],
      "kind": "command",
      "repository": "main",
      "requires": [
        "engine"
      ],
      "args": [
        "build",
        "cbinding...,standalone..."
      ],
      "timeoutMs": 1800000
    },
    {
      "id": "main-tests",
      "covers": [
        "R1"
      ],
      "kind": "command",
      "repository": "main",
      "requires": [
        "main-build"
      ],
      "args": [
        "-r",
        "test"
      ],
      "timeoutMs": 1800000
    },
    {
      "id": "memory",
      "covers": [
        "C1"
      ],
      "kind": "session",
      "case": "memory",
      "repository": "main",
      "requires": [
        "data"
      ],
      "timeoutMs": 1800000,
      "blocked": "No reviewed memory session collector is registered. Per-service JS and native samples alone do not prove the editor process-tree total, which is what the memory target requires."
    },
    {
      "id": "clean-install",
      "covers": [
        "D1"
      ],
      "kind": "collector",
      "repository": "main",
      "requires": [
        "main-build",
        "checks"
      ],
      "timeoutMs": 1800000,
      "blocked": "No reviewed clean-checkout install collector is registered; the fresh-checkout install, check, build and SDK-selection evidence still has to be collected and validated."
    },
    {
      "id": "tnb-guards",
      "covers": [
        "R1"
      ],
      "kind": "tnb-guards",
      "repository": "tnb",
      "condition": "tnb-changed",
      "timeoutMs": 600000,
      "blocked": "No reviewed TNB guard collector is registered; the four existing check:* guards have to be executed through the harness and validated against the pinned submodules and patches."
    },
    {
      "id": "tnb-witnesses",
      "covers": [
        "R1"
      ],
      "kind": "tnb-witnesses",
      "repository": "tnb",
      "condition": "tnb-changed",
      "requires": [
        "tnb-guards"
      ],
      "timeoutMs": 1800000,
      "blocked": "No reviewed TNB witness collector is registered; witness group wiring output is not witness execution."
    },
    {
      "id": "tnb-navigation",
      "covers": [
        "R1"
      ],
      "kind": "command",
      "repository": "tnb",
      "condition": "tnb-changed",
      "requires": [
        "tnb-guards"
      ],
      "args": [
        "run",
        "check:sim-nav"
      ],
      "timeoutMs": 1800000,
      "blocked": "No reviewed TNB navigation collector is registered for the simulated navigation suite."
    },
    {
      "id": "tnb-volar",
      "covers": [
        "R1"
      ],
      "kind": "volar",
      "repository": "tnb",
      "condition": "tnb-changed",
      "requires": [
        "tnb-guards"
      ],
      "timeoutMs": 1800000,
      "blocked": "No reviewed TNB Volar collector is registered; the downstream Volar suite still has to be executed and validated with GamingTS semantics."
    },
    {
      "id": "platforms",
      "covers": [
        "D1"
      ],
      "kind": "collector",
      "repository": "main",
      "timeoutMs": 1800000,
      "blocked": "No reviewed cross-platform capability collector is registered; win32 is prepared locally, linux still needs a prepared runtime and a matching negative proof."
    }
  ],
