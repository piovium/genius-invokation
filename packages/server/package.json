{
  "name": "@gi-tcg/server",
  "private": true,
  "version": "0.20.8",
  "type": "module",
  "scripts": {
    "dev": "pnpm prepare:metadata && gnx --env-file-if-exists=.env --watch src/main.ts",
    "prepare:metadata": "gnx scripts/deck-metadata.ts",
    "build": "gnx scripts/build.ts",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "check": "pnpm prepare:metadata && tsc --noEmit",
    "migrate": "gnx --env-file-if-exists=.env src/db/migrate.ts",
    "test:http": "pnpm prepare:metadata && gnx --test src/auth/auth.test.ts src/frontend.test.ts src/http.test.ts src/app.test.ts",
    "test:db": "pnpm prepare:metadata && gnx --test src/db/database.test.ts src/db/migrate.test.ts",
    "test:metadata": "pnpm prepare:metadata && gnx --test src/deck-metadata.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@gi-tcg/assets-manager": "workspace:*",
    "@gi-tcg/config": "workspace:*",
    "@gi-tcg/core": "workspace:*",
    "@gi-tcg/data": "workspace:*",
    "@gi-tcg/data-code-analyzer": "workspace:*",
    "@gi-tcg/typings": "workspace:*",
    "@gi-tcg/utils": "workspace:*",
    "@paralleldrive/cuid2": "^2.2.2",
    "axios": "catalog:",
    "ioredis": "^5.10.1",
    "prom-client": "^15.1.3",
    "semver": "^7.8.0",
    "elysia": "1.4.30",
    "drizzle-orm": "0.45.2",
    "@elysiajs/node": "1.4.5",
    "pg": "8.23.0",
    "ws": "8.21.3",
    "mrmime": "2.0.1",
    "exact-mirror": "0.2.7"
  },
  "devDependencies": {
    "@gi-tcg/web-client": "workspace:*",
    "@gi-tcg/unplugin-gts": "catalog:",
    "@types/semver": "^7.7.1",
    "rolldown": "^1.0.0-rc.15",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.1"
  }
}
