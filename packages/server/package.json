{
  "name": "@gi-tcg/server",
  "private": true,
  "version": "0.21.0",
  "type": "module",
  "scripts": {
    "dev": "gnx ./src/dev.ts",
    "build": "gnx scripts/build.ts",
    "start": "node --experimental-vm-modules --enable-source-maps --import ./scripts/ts_preload.js src/main.ts",
    "check": "tsc --noEmit",
    "debug": "gnx ./src/dev.ts --inspect",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import ./scripts/ts_preload.js scripts/migrate.ts",
    "test:db": "node --import ./scripts/ts_preload.js --test test/db.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@fastify/etag": "^6.1.0",
    "@gi-tcg/assets-manager": "workspace:*",
    "@gi-tcg/config": "workspace:*",
    "@gi-tcg/core": "workspace:*",
    "@gi-tcg/data": "workspace:*",
    "@gi-tcg/data-code-analyzer": "workspace:*",
    "@gi-tcg/typings": "workspace:*",
    "@gi-tcg/utils": "workspace:*",
    "@nestjs/common": "^11.1.17",
    "@nestjs/core": "^11.1.17",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-fastify": "^11.1.17",
    "@paralleldrive/cuid2": "^2.2.2",
    "axios": "catalog:",
    "class-transformer": "^0.5.1",
    "class-validator": "0.14.1",
    "execa": "catalog:",
    "ioredis": "^5.10.1",
    "mime": "^4.0.6",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "semver": "^7.8.0",
    "simple-git": "^3.36.0",
    "drizzle-orm": "1.0.0-rc.4",
    "pg": "^8.16.3",
    "ts-node": "^10.9.2",
    "@swc/core": "^1.15.33",
    "dotenv": "^17.4.2",
    "typescript": "catalog:"
  },
  "devDependencies": {
    "@gi-tcg/web-client": "workspace:*",
    "@types/semver": "^7.7.1",
    "fastify": "^5.8.2",
    "drizzle-kit": "1.0.0-rc.4",
    "@types/pg": "^8.15.6",
    "@electric-sql/pglite": "^0.3.14"
  },
  "files": [
    "src",
    "scripts",
    "tsconfig.json",
    "drizzle",
    "public"
  ]
}
