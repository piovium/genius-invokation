{
  "name": "@gi-tcg/server",
  "private": true,
  "version": "0.21.0",
  "type": "module",
  "imports": {
    "#custom-data-loader": "@gi-tcg/custom-data-loader/gts/data"
  },
  "scripts": {
    "dev": "gnx ./src/dev.ts",
    "start": "NODE_ENV=production node --experimental-vm-modules --enable-source-maps --import ./scripts/ts_preload.js src/main.ts",
    "check": "tsc --noEmit",
    "debug": "gnx ./src/dev.ts --inspect",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@gi-tcg/assets-manager": "workspace:*",
    "@gi-tcg/config": "workspace:*",
    "@gi-tcg/core": "workspace:*",
    "@gi-tcg/custom-data-loader": "workspace:*",
    "@gi-tcg/data": "workspace:*",
    "@gi-tcg/data-code-analyzer": "workspace:*",
    "@gi-tcg/typings": "workspace:*",
    "@gi-tcg/utils": "workspace:*",
    "@hono/node-server": "^2.0.2",
    "@hono/standard-validator": "^0.4.0",
    "@paralleldrive/cuid2": "^2.2.2",
    "@standard-schema/spec": "^1.1.0",
    "@swc/core": "^1.15.33",
    "arktype": "^2.2.0",
    "axios": "catalog:",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-rc.4",
    "execa": "catalog:",
    "hono": "^4.12.18",
    "ioredis": "^5.10.1",
    "jiti": "^2.7.0",
    "json5": "^2.2.3",
    "mime": "^4.0.6",
    "pg": "^8.16.3",
    "prom-client": "^15.1.3",
    "rxjs": "^7.8.1",
    "semver": "^7.8.0",
    "simple-git": "^3.36.0",
    "smol-toml": "^1.9.1",
    "ts-node": "^10.9.2",
    "typescript": "catalog:",
    "yaml": "^2.9.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@gi-tcg/web-client": "workspace:*",
    "@types/pg": "^8.15.6",
    "@types/semver": "^7.7.1",
    "drizzle-kit": "1.0.0-rc.4"
  },
  "files": [
    "src",
    "presets",
    "scripts",
    "tsconfig.json",
    "drizzle"
  ],
  "gamingTs": {
    "providerImportSource": "@gi-tcg/custom-data-loader/gts",
    "runtimeImportSource": "@gi-tcg/custom-data-loader/gts/runtime"
  }
}
