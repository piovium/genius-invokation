{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "GamingTS",
  "scopeName": "source.gts",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#definition" },
    { "include": "#directives" },
    { "include": "#numbers" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.gts", "match": "//.*$" },
        {
          "name": "comment.block.gts",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.gts",
          "begin": "\\\"",
          "end": "\\\"",
          "patterns": [
            { "name": "constant.character.escape.gts", "match": "\\\\." }
          ]
        },
        {
          "name": "string.quoted.single.gts",
          "begin": "'",
          "end": "'",
          "patterns": [
            { "name": "constant.character.escape.gts", "match": "\\\\." }
          ]
        }
      ]
    },
    "definition": {
      "patterns": [
        {
          "match": "\\bdefine\\s+(character|card|skill|status|combatStatus|summon|attachment)\\b",
          "captures": {
            "0": { "name": "meta.definition.gts" },
            "1": { "name": "entity.name.type.gts" }
          }
        },
        { "name": "keyword.control.gts", "match": "\\b(as|define)\\b" }
      ]
    },
    "directives": {
      "patterns": [
        { "name": "support.function.gts", "match": ":[A-Za-z_$][\\w$]*" },
        { "name": "variable.other.property.gts", "match": "\\b[A-Za-z_$][\\w$]*(?=\\s)" }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.gts", "match": "\\b(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?\\b" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.gts", "match": "=>|===?|!==?|[+*/%<>]=?|&&|\\|\\|" }
      ]
    }
  }
}
