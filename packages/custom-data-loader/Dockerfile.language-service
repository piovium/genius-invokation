# Build from the repository root:
# docker build -f packages/custom-data-loader/Dockerfile.language-service .
FROM node:26.8.1-bookworm-slim@sha256:367679cf9792759492a486e4aa4b421764d71a9546a6dae8aab81a99eb797b3e AS base
RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates openssl \
    && rm -rf /var/lib/apt/lists/*

FROM base AS build
WORKDIR /workspace
RUN npm install --global pnpm@12.0.0
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm build "custom-data-loader..."
ARG VITE_GTS_LANGUAGE_SERVER_URL=/gts
ENV VITE_GTS_LANGUAGE_SERVER_URL=${VITE_GTS_LANGUAGE_SERVER_URL}
RUN pnpm --filter @gi-tcg/custom-data-loader build:web
# This repository uses linked workspace packages, so use pnpm's supported
# legacy deployment implementation instead of requiring injected dependencies.
RUN pnpm --filter @gi-tcg/custom-data-loader deploy --legacy --prod --frozen-lockfile /release

FROM scratch AS web-artifacts
COPY --from=build /workspace/packages/custom-data-loader/dist/web/ /

FROM base AS language-service
WORKDIR /app
COPY --from=build --chown=node:node /release/ ./
ENV NODE_ENV=production
ENV GTS_LANGUAGE_SERVER_HOST=0.0.0.0
ENV GTS_LANGUAGE_SERVER_PORT=3001
USER node
EXPOSE 3001
CMD ["node", "scripts/language-server.mjs"]
