{
  "name": "@gi-tcg/custom-data-loader",
  "private": true,
  "version": "0.20.7+gi-6-0-0",
  "description": "Provides an easy way to load your custom data for GI-TCG",
  "type": "module",
  "files": [
    "dist",
    "scripts/language-server.mjs",
    "src/dev-language-workspace.ts"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./gts/vm": {
      "development": "./src/gts/vm.ts",
      "types": "./dist/gts/vm.d.ts",
      "import": "./dist/gts/vm.js"
    },
    "./gts/runtime": {
      "development": "./src/gts/runtime.ts",
      "types": "./dist/gts/runtime.d.ts",
      "import": "./dist/gts/runtime.js"
    },
    "./gts/data": {
      "development": "./src/gts/data.ts",
      "types": "./dist/gts/data.d.ts",
      "import": "./dist/gts/data.js"
    }
  },
  "scripts": {
    "predev": "pnpm build",
    "dev": "vite",
    "dev:language-server": "node scripts/language-server.mjs",
    "start:language-server": "node scripts/language-server.mjs",
    "build:web": "vite build --outDir dist/web --emptyOutDir",
    "check": "tsc --noEmit",
    "test": "vitest",
    "test:browser": "vitest run --config vite.browser.config.ts",
    "build": "tsdown"
  },
  "dependencies": {
    "@gi-tcg/data": "workspace:*",
    "@gi-tcg/gts-transpiler": "catalog:",
    "@gi-tcg/gts-language-server": "catalog:",
    "@gi-tcg/gts-runtime": "catalog:",
    "esbuild-wasm": "^0.27.3",
    "typescript": "npm:typescript-native-bridge@6.0.3-bridge.16.tsgo.7.0.2",
    "vscode-uri": "3.1.0",
    "vscode-ws-jsonrpc": "3.5.0",
    "ws": "8.20.1"
  },
  "gamingTs": {
    "runtimeImportSource": "@gi-tcg/custom-data-loader/gts/runtime",
    "providerImportSource": "@gi-tcg/custom-data-loader/gts/vm"
  },
  "peerDependencies": {
    "@gi-tcg/core": "workspace:*"
  },
  "devDependencies": {
    "@codingame/monaco-vscode-api": "~25.1.2",
    "@codingame/monaco-vscode-editor-api": "~25.1.2",
    "@codingame/monaco-vscode-files-service-override": "~25.1.2",
    "@codingame/monaco-vscode-keybindings-service-override": "~25.1.2",
    "@codingame/monaco-vscode-textmate-service-override": "~25.1.2",
    "@codingame/monaco-vscode-theme-defaults-default-extension": "~25.1.2",
    "@gi-tcg/assets-manager": "workspace:*",
    "@gi-tcg/deck-builder": "workspace:*",
    "@gi-tcg/gts-language-client-code": "catalog:",
    "@gi-tcg/typings": "workspace:*",
    "@gi-tcg/web-ui-core": "workspace:*",
    "dts-bundle-generator": "^9.5.1",
    "monaco-languageclient": "~10.7.0",
    "monaco-editor": "npm:@codingame/monaco-vscode-editor-api@~25.1.2",
    "puppeteer-core": "25.0.4",
    "rolldown": "^1.0.0-rc.15",
    "solid-js": "catalog:",
    "unplugin-dts": "^1.0.0",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "vscode": "npm:@codingame/monaco-vscode-extension-api@~25.1.2",
    "vscode-languageclient": "~9.0.1"
  }
}
